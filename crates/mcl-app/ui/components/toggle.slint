import { Tokens } from "../theme.slint";

// 开关（模组启用 / 禁用）：38×22 轨道 + 18px 白色滑块。
// 业务状态由调用方通过 checked 传入，组件只负责外观与点击（R4）。
export component Toggle inherits Rectangle {
    in property <bool> checked: false;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 38px;
    height: 22px;
    horizontal-stretch: 0;
    border-radius: 11px;
    background: !root.enabled
        ? Tokens.border
        : root.checked ? Tokens.success : #C9C9CF;
    opacity: root.enabled ? 1.0 : 0.55;
    accessible-role: checkbox;
    accessible-label: root.checked ? "已启用" : "已禁用";
    accessible-enabled: root.enabled;

    Rectangle {
        y: 2px;
        width: 18px;
        height: 18px;
        border-radius: 9px;
        background: white;
        x: root.checked ? parent.width - 20px : 2px;
        animate x {
            duration: 140ms;
            easing: ease-out;
        }
    }

    TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.toggled(!root.checked);
            }
        }
    }
}
