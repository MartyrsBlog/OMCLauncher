import { Tokens } from "../theme.slint";
import { Icon } from "./icon.slint";

// 小图标按钮（28×28）：表格行尾的删除、卡片角上的关闭等。
export component IconButton inherits Rectangle {
    in property <int> icon: 10;
    in property <color> icon-color: Tokens.text-tertiary;
    in property <bool> enabled: true;
    callback clicked();

    width: 28px;
    height: 28px;
    border-radius: 8px;
    background: touch.has-hover && root.enabled ? Tokens.surface-hover : transparent;
    opacity: root.enabled ? 1.0 : 0.4;

    Icon {
        kind: root.icon;
        icon-size: 15px;
        weight: 1.7px;
        icon-color: root.icon-color;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }

    touch := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.clicked();
            }
        }
    }
}
