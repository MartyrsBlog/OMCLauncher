// 线条图标集（24×24 视口，Path 绘制，不引入位图素材）
//
// 与导航/按钮共用；新增图标只在这里加分支，页面不再各画各的 Path。
// kind：1 首页 / 2 实例 / 3 版本安装 / 4 资源 / 5 下载 / 6 设置 / 7 播放
//       8 加号 / 9 搜索 / 10 关闭 / 11 右箭头 / 12 左箭头 / 13 勾 / 14 警告
//       15 用户 / 16 外链 / 17 文件夹 / 19 刷新
//       20 删除 / 21 文件 / 22 太阳 / 23 列表 / 24 滑杆 / 25 更多（⋯）/ 27 下箭头
export component Icon inherits Rectangle {
    in property <int> kind: 0;
    in property <length> icon-size: 20px;
    in property <color> icon-color: #1D1D1F;
    in property <length> weight: 1.6px;

    width: root.icon-size;
    height: root.icon-size;
    background: transparent;

    if root.kind == 1 : Path {
        width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24;
        commands: "M4 10.5 L12 4 L20 10.5 L20 20 L14.5 20 L14.5 14.5 L9.5 14.5 L9.5 20 L4 20 Z";
        stroke: root.icon-color; stroke-width: root.weight; fill: transparent;
    }
