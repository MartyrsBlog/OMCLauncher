        commands: "M12 3 L12 15 M7.5 10.5 L12 15 L16.5 10.5 M4 19 L20 19";
        stroke: root.icon-color; stroke-width: root.weight; fill: transparent;
    }
    if root.kind == 6 : Path {
        width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24;
        commands: "M12 8.2 A3.8 3.8 0 1 0 12 15.8 A3.8 3.8 0 1 0 12 8.2 Z M12 2.5 L12 5 M12 19 L12 21.5 M2.5 12 L5 12 M19 12 L21.5 12 M5.3 5.3 L7 7 M17 17 L18.7 18.7 M18.7 5.3 L17 7 M7 17 L5.3 18.7";
