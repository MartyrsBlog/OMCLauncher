        commands: "M6 9.5 L12 15.5 L18 9.5";
        stroke: root.icon-color; stroke-width: root.weight; fill: transparent;
    }

    // 25 更多：行尾「⋯」菜单入口
    if root.kind == 25 : Path {
        width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24;
        commands: "M5.2 12 L5.8 12 M11.4 12 L12 12 M17.6 12 L18.2 12";
        stroke: root.icon-color; stroke-width: 2.6px; fill: transparent;
    }

    if root.kind == 24 : Path {
        width: 100%; height: 100%; viewbox-width: 24; viewbox-height: 24;
        commands: "M3.5 7.8 L20.5 7.8 M3.5 16.2 L20.5 16.2 M9 5 L9 10.6 M15.5 13.4 L15.5 19";
        stroke: root.icon-color; stroke-width: root.weight; fill: transparent;
