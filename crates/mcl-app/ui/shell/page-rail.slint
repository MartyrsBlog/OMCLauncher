import { Tokens } from "../theme.slint";
import { Icon } from "../components/icon.slint";
import { InstanceAvatar } from "../components/instance-avatar.slint";

//   栏宽 200px / 底色 nav-surface / 右侧 1px 描边
//   条目 30px 高、圆角 7、选中 #0066CC 填充白字
//   图标槽固定 16px（相对 x=10 → 绝对 18），文本列固定 x=34（绝对 42）
//   分组标题 11px（绝对 x=16），组内条目间距 4，组间距 20
// 四页共用同一套原语，避免各页各画一套导致文本列错位。

// ── 分组标题 ──
export component RailGroup inherits Rectangle {
    in property <string> label;

    height: 18px;
    background: transparent;

    Text {
        x: 8px;
        width: parent.width - 8px;
        height: parent.height;
        text: root.label;
        font-size: 11px;
        font-weight: 600;
        color: Tokens.nav-group;
        vertical-alignment: center;
        overflow: elide;
    }
}

// ── 条目 ──
export component RailItem inherits Rectangle {
    in property <string> label;
    // 0 = 无图标；文本列不因此移动
    in property <int> icon: 0;
    // -1 = 不显示计数
    in property <int> count: -1;
    in property <bool> selected: false;
    // 次要动作（「添加目录…」）用主色文字
    in property <bool> accent: false;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.selected
        ? Tokens.nav-active
        : row-touch.has-hover ? Tokens.nav-hover : transparent;

    HorizontalLayout {
        padding-left: 34px;
        padding-right: 12px;
        spacing: 8px;

        Text {
            text: root.label;
            font-size: 12.5px;
            font-weight: root.selected ? 600 : 400;
            color: root.selected
                ? Tokens.nav-text-active
                : root.accent ? Tokens.primary : Tokens.nav-text;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }

        if root.count >= 0 : Text {
            text: root.count;
            font-size: 11px;
            font-weight: 500;
            color: root.selected ? Tokens.nav-text-active : Tokens.text-tertiary;
            vertical-alignment: center;
        }
    }

    if root.icon > 0 : Icon {
        x: 10px;
        y: (parent.height - 16px) / 2;
        icon-size: 16px;
        weight: 1.35px;
        kind: root.icon;
        icon-color: root.selected ? Tokens.nav-text-active : Tokens.nav-text;
    }

    row-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// ── 底部动作行（分隔线上方由调用方画）──
export component RailFooterItem inherits Rectangle {
    in property <string> label;
    in property <int> icon: 0;
    // false = 纯标识（如「共享资源」），不显示 hover 也不发回调
    in property <bool> interactive: true;
    callback clicked();

    height: 30px;
    border-radius: 7px;
    background: root.interactive && foot-touch.has-hover ? Tokens.nav-hover : transparent;

    // 有图标时与条目同一文本列（12.5px）；无图标时是小号标识（11px，x=10）
    Text {
        x: root.icon > 0 ? 34px : 10px;
        width: parent.width - self.x - 12px;
        height: parent.height;
        text: root.label;
        font-size: root.icon > 0 ? 12.5px : 11px;
        color: root.icon > 0 ? Tokens.nav-text : Tokens.nav-group;
        vertical-alignment: center;
        overflow: elide;
    }

    if root.icon > 0 : Icon {
        x: 10px;
        y: (parent.height - 16px) / 2;
        icon-size: 16px;
        weight: 1.35px;
        kind: root.icon;
        icon-color: Tokens.nav-text;
    }

    foot-touch := TouchArea {
        mouse-cursor: root.interactive ? pointer : default;
        clicked => {
            if (root.interactive) {
                root.clicked();
            }
        }
    }
}

// 下载中心（current-page 2 / 3）：游戏 / 内容 / 任务 三组 + 底部「下载设置」
export component DownloadRail inherits Rectangle {
    // 0 游戏版本 / 1 整合包 / 2 模组 / 3 资源包 / 4 光影 / 5 队列
    in property <int> selected: 0;
    in property <int> queue-count: 0;

    callback select(int);
    callback open-settings();

    width: Tokens.rail-width;
    height: 100%;
    background: Tokens.nav-surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Tokens.border;
    }

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        VerticalLayout {
            padding-top: 18px;
            spacing: 20px;

            VerticalLayout {
                spacing: 0px;
                RailGroup { label: "游戏"; }
                VerticalLayout {
                    spacing: 4px;
                    RailItem {
                        label: "游戏版本";
                        icon: 2;
                        selected: root.selected == 0;
                        clicked => { root.select(0); }
                    }
                    RailItem {
                        label: "整合包";
                        icon: 4;
                        selected: root.selected == 1;
                        clicked => { root.select(1); }
                    }
                }
            }

            VerticalLayout {
                spacing: 0px;
                RailGroup { label: "内容"; }
                VerticalLayout {
                    spacing: 4px;
                    RailItem {
                        label: "模组";
                        icon: 21;
                        selected: root.selected == 2;
                        clicked => { root.select(2); }
                    }
                    RailItem {
                        label: "资源包";
                        icon: 2;
                        selected: root.selected == 3;
                        clicked => { root.select(3); }
                    }
                    RailItem {
                        label: "光影";
                        icon: 22;
                        selected: root.selected == 4;
                        clicked => { root.select(4); }
                    }
                }
            }

            VerticalLayout {
                spacing: 0px;
                RailGroup { label: "任务"; }
                VerticalLayout {
                    spacing: 4px;
                    RailItem {
                        label: "队列";
                        icon: 23;
                        count: root.queue-count;
                        selected: root.selected == 5;
                        clicked => { root.select(5); }
                    }
                }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Rectangle {
            x: 8px;
            width: parent.width - 16px;
            height: 1px;
            background: Tokens.border;
        }

        VerticalLayout {
            padding-bottom: 30px;

            RailFooterItem {
                label: "下载设置";
                icon: 6;
                clicked => { root.open-settings(); }
            }
        }
    }
}

export component SettingsRail inherits Rectangle {
    // 0 下载与网络 / 1 游戏默认 / 2 存储与维护 / 3 外观与动效 / 4 关于
    in property <int> selected: 0;
    callback select(int);

    width: Tokens.rail-width;
    height: 100%;
    background: Tokens.nav-surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Tokens.border;
    }

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 18px;
        padding-bottom: 30px;
        spacing: 20px;

        VerticalLayout {
            spacing: 0px;
            RailGroup { label: "启动器"; }
            VerticalLayout {
                spacing: 4px;
                RailItem {
                    label: "下载与网络";
                    selected: root.selected == 0;
                    clicked => { root.select(0); }
                }
                RailItem {
                    label: "游戏默认";
                    selected: root.selected == 1;
                    clicked => { root.select(1); }
                }
                RailItem {
                    label: "存储与维护";
                    selected: root.selected == 2;
                    clicked => { root.select(2); }
                }
                RailItem {
                    label: "外观与动效";
                    selected: root.selected == 3;
                    clicked => { root.select(3); }
                }
            }
        }

        VerticalLayout {
            spacing: 0px;
            RailGroup { label: "关于"; }
            VerticalLayout {
                spacing: 4px;
                RailItem {
                    label: "关于 OMCLauncher";
                    selected: root.selected == 4;
                    clicked => { root.select(4); }
                }
            }
        }
    }
}

// 实例工作台（current-page 6）：实例头 + 概览 / 组件 / 模组 / 日志 / 设置
export component WorkbenchRail inherits Rectangle {
    in property <int> selected: 0;
    in property <string> instance-name: "";
    // 左列窄，用短摘要（如「1.20.1 · Fabric」），完整摘要留在页头
    in property <string> instance-info: "";
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <string> icon-text: "";

    callback select(int);

    width: Tokens.rail-width;
    height: 100%;
    background: Tokens.nav-surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Tokens.border;
    }

    VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 0px;

        // ── 实例头（32px 图标 + 名称 + 短摘要）──
        HorizontalLayout {
            padding-top: 26px;
            padding-left: 4px;
            height: 58px;
            spacing: 8px;

            InstanceAvatar {
                avatar-size: 32px;
                source: root.icon;
                has-image: root.has-icon;
                fallback: root.icon-text;
            }

            VerticalLayout {
                height: 32px;
                spacing: 0px;
                horizontal-stretch: 1;

                Text {
                    text: root.instance-name;
                    font-size: 12px;
                    font-weight: 600;
                    color: Tokens.text;
                    height: 17px;
                    vertical-alignment: bottom;
                    overflow: elide;
                }

                Text {
                    text: root.instance-info;
                    font-size: 10.5px;
                    color: Tokens.nav-group;
                    height: 15px;
                    vertical-alignment: top;
                    overflow: elide;
                }
            }
        }

        Rectangle { height: 12px; background: transparent; }

        VerticalLayout {
            spacing: 4px;

            RailItem {
                label: "概览";
                icon: 18;
                selected: root.selected == 0;
                clicked => { root.select(0); }
            }
            RailItem {
                label: "组件";
                icon: 24;
                selected: root.selected == 1;
                clicked => { root.select(1); }
            }
            RailItem {
                label: "模组";
                icon: 21;
                selected: root.selected == 2;
                clicked => { root.select(2); }
            }
            RailItem {
                label: "日志";
                icon: 23;
                selected: root.selected == 3;
                clicked => { root.select(3); }
            }
            RailItem {
                label: "设置";
                icon: 6;
                selected: root.selected == 4;
                clicked => { root.select(4); }
            }
        }

        Rectangle { vertical-stretch: 1; background: transparent; }

        Rectangle {
            x: 8px;
            width: parent.width - 16px;
            height: 1px;
            background: Tokens.border;
        }

        VerticalLayout {
            padding-bottom: 30px;
            RailFooterItem {
                label: "共享资源";
                interactive: false;
            }
        }
    }
}
